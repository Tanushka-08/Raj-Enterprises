# MongoDB Connection (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/raj-enterprises

# Server Port
PORT=5000

# JWT Secret (change this to a strong secret in production)
JWT_SECRET=your_jwt_secret_key_here

# Client URL(s) for CORS (comma separated)
CLIENT_URL=http://localhost:5173

# Default admin created by `npm run seed` (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=aquarajenterprises@gmail.com

# Node Environment
NODE_ENV=development
